# Copy to `.env` (never commit) and fill in values from your OWN copy of the official mobile app's
# awsconfiguration.json / amplifyconfiguration.json. See docs/AUTH_FLOW.md for the discovery steps.
# Helper to detect which stack accepts your password: `npm run cli -- cognito` (needs cognito-stacks.local.json).

# --- Login (your own account) ---
MAVEO_EMAIL=you@example.com
MAVEO_PASSWORD=your-password

# --- Required AWS / IoT configuration (no library defaults — supply all four) ---
# Cognito User Pool app client id (string, no quotes; from awsconfiguration.json -> CognitoUserPool.Default.AppClientId)
MAVEO_COGNITO_CLIENT_ID=
# Cognito Identity Pool id in `<region>:<uuid>` shape (CredentialsProvider.CognitoIdentity.Default.PoolId)
MAVEO_COGNITO_IDENTITY_POOL_ID=
# AWS region for both ids above
MAVEO_REGION=
# Fully-qualified IoT broker hostname (no scheme, no path, no port)
MAVEO_IOT_HOSTNAME=

# --- Stick (MQTT clientId / thing name from the app) — only one client (app OR your code) should use this online ---
# Visible in the official app; treat as identifying the device, not a secret.
# MAVEO_THING_NAME=
# MAVEO_MQTT_CLIENT_ID=

# Optional: switch SigV4 strategy. Default is header-based (recommended).
# MAVEO_MQTT_WSS_SIGNING=query

# --- npm run cli -- listen ---
# MAVEO_LISTEN_MS=12000
# MAVEO_RUN_OPEN=0

# --- Vitest live (@ tests/live.*.test.ts); unset or 0 for day-to-day ---
# MAVEO_LIVE_TEST=1
# MAVEO_RUN_LIVE_MQTT=1
# MAVEO_LIVE_GARAGE=1

# BlueFi below needs LIVE_TEST + RUN_LIVE_MQTT + stick serial. Door flags MOVE the door.
# MAVEO_RUN_BLUEFI_SCENARIO=1
# Walk to the garage before door/light actions (applies to all BlueFi live tests in live.bluefi.test.ts)
# MAVEO_LIVE_BLUEFI_START_DELAY_MS=20000
# MAVEO_SCENARIO_OPEN_DWELL_MS=10000
# MAVEO_SCENARIO_LIGHT_DWELL_MS=5000
# MAVEO_SCENARIO_DOOR_TIMEOUT_MS=90000
# MAVEO_SCENARIO_READ_TIMEOUT_MS=15000
# MAVEO_SCENARIO_DEBUG_LOG=1

# MAVEO_LIVE_BLUEFI_DOOR=1
# MAVEO_LIVE_BLUEFI_LIGHT=1
# MAVEO_LIVE_BLUEFI_LIGHT_RELAXED=1
# MAVEO_LIVE_BLUEFI_PASSIVE=1
# MAVEO_LIVE_BLUEFI_LISTEN_MS=120000
# MAVEO_LIVE_BLUEFI_PASSIVE_MIN_DOOR_EVENTS=1
# MAVEO_LIVE_BLUEFI_PASSIVE_ALLOW_SILENT=1

# Quick runs: npm run test:unit (skips live.*). Guided scenario: npm run bluefi:scenario. Passive listen: npm run bluefi:passive (+ MAVEO_LIVE_BLUEFI_PASSIVE=1)

# --- Optional: MQTT reclaim / session contention (see README "MQTT session lifecycle" -> Reclaim & session contention) ---
# Picked up by mergeAutomaticMqttReclaimOptionsFromEnv() (e.g. live.bluefi passive + guided scenario).
# MAVEO_MQTT_SESSION_CONTENTION=1
# Rolling window (ms) for counting remote MQTT kicks toward a "burst"
# MAVEO_MQTT_CONTENTION_BURST_WINDOW_MS=10000
# Number of kicks inside that window -> pause auto-reclaim (app gets the line)
# MAVEO_MQTT_CONTENTION_BURST_THRESHOLD=3
# How long auto-reclaim stays off after a burst (ms). Env min 5000. Default prod: 120000.
# For faster live tests (e.g. bluefi:passive) try 10000 instead of waiting 2 minutes:
# MAVEO_MQTT_CONTENTION_BACKOFF_MS=10000
# MAVEO_MQTT_RECLAIM_MAX_ATTEMPTS=8
# Delay between attempts within one reclaim batch (ms)
# MAVEO_MQTT_RECLAIM_DELAY_MS=2000
# Poll while waiting for getDoorPosition / getLightOn (disconnect detection) — createMaveoConnectStickClientFromEnv only
# MAVEO_BLUEFI_RSP_POLL_MS=400
