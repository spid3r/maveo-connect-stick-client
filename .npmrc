# --- Security defaults ----------------------------------------------------------
# Do not execute lifecycle scripts (install / preinstall / postinstall / prepare)
# of any package — including transitive dependencies. Defends against
# supply-chain attacks where a hijacked dep ships a malicious postinstall script
# (e.g. the 2024 polyfill.io / chalk-related incidents).
#
# Trade-off for THIS repo:
#  - Our own root `prepare` script (which sets up Husky git hooks) will NOT run
#    automatically on `npm ci`. After a fresh checkout, run once:
#       npm run prepare
#  - CI does not need git hooks (HUSKY=0 in workflows), so CI is unaffected.
ignore-scripts=true

# --- Publishing -----------------------------------------------------------------
# Use the public registry explicitly, do not let any environment override it
# silently into a private mirror.
registry=https://registry.npmjs.org/

# Mirror the package.json `publishConfig.provenance: true`. Effective only when
# publishing from a Trusted Publisher (OIDC) context — npm just ignores it for
# token-based publishes that don't have OIDC available.
provenance=true

# --- Install hygiene ------------------------------------------------------------
# Refuse to install if package-lock.json is missing or out of sync (catches
# accidental dep drift in PRs).
package-lock=true

# Warn loudly when a contributor uses a Node version that does not satisfy
# `engines.node` in package.json.
engine-strict=true

# Less noise during install.
fund=false
